<IfModule mod_rewrite.c>
    RewriteEngine On

    # Jika file atau direktori tersedia, layani langsung
    RewriteCond %{REQUEST_FILENAME} -f [OR]
    RewriteCond %{REQUEST_FILENAME} -d
    RewriteRule ^ - [L]

    # Jika tidak tersedia, arahkan ke index.html
    RewriteRule ^ index.html [L]
</IfModule>